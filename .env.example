# 复制成 .env 再填。.env 不会进仓库。

# 对外地址：Cloudflare 隧道里给 River 配的那个域名
RIVER_PUBLIC_URL=https://river.example.com
# 连接器授权时要输的密码，取长一点
RIVER_PASSWORD=
# 原文里人类那一方显示成什么名字
RIVER_HUMAN_NAME=零零
RIVER_TZ=Asia/Shanghai

# Cloudflare Zero Trust 里建隧道时给的 token（--token 后面那一长串）
TUNNEL_TOKEN=

# 拉不下 python:3.12-slim 时，用本机已有的 Ombre 镜像当底子（不用再下载）
# RIVER_BASE_IMAGE=p0luz/ombre-brain:latest
